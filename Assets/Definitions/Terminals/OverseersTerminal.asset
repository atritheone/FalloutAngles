  m_EditorClassIdentifier: Assembly-CSharp::TerminalDefinition
  terminalName: Overseer's Terminal
  document:
    terminalTitle: Welcome, Overseer.
    startupPageId: main
    pages:
    - pageId: main
      body: 
      includeBackOption: 1
      backOptionLabel: '> Back'
      includeExitOption: 1
      exitOptionLabel: '> Log Off'
      options:
      - label: View Security Dossiers
        action: 0
        targetPageId: securitydossiers
        addCurrentPageToHistory: 1
